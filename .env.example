# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.

DEBUG=True
SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,vms.alphaorange.net
CSRF_TRUSTED_ORIGINS=https://vms.alphaorange.net
# Public base URL for links in notification emails
SITE_URL=http://localhost:8000

# True uses the local SQLite file. Set False and set DATABASE_URL for Postgres.
USE_SQLITE=True

# Local Postgres on this server
# DATABASE_URL=postgres://vms:YOUR_PASSWORD@127.0.0.1:5432/vms

# PDF storage. Leave the URL and keys empty to store files on local disk (MEDIA_ROOT).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vendor-documents

# Google OAuth (required for “Sign in with Google”)
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# 2. Authorized JavaScript origins (add both):
#    http://localhost:8000
#    http://127.0.0.1:8000
# 3. Authorized redirect URIs (add both — exact match, trailing slash matters):
#    http://localhost:8000/accounts/google/login/callback/
#    http://127.0.0.1:8000/accounts/google/login/callback/
# 4. Paste Client ID + Client Secret here (no spaces around =)
# Local runserver: open http://localhost:8000 (app auto-redirects 127.0.0.1 → localhost)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (console backend is used automatically when DEBUG=True)
EMAIL_FROM_NAME=Alpha Orange VMS
DEFAULT_FROM_EMAIL=noreply@aosb-vms.local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# Base URL for links inside notification emails (your public domain in production)
SITE_URL=http://localhost:8000
