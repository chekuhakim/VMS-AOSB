# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.

DEBUG=True
SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Keep True until Supabase Postgres is ready; then set False + DATABASE_URL
USE_SQLITE=True

# Supabase Postgres (Transaction pooler recommended for Django)
# DATABASE_URL=postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Storage (PDF vendor documents)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vendor-documents

# Google OAuth (optional for Phase 1 — leave blank to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (console backend is used automatically when DEBUG=True)
DEFAULT_FROM_EMAIL=noreply@aosb-vms.local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
